{
  "name": "sparkkindly",
  "version": "1.0.0",
  "description": "SparkKindly editorial website and daily quiz",
  "scripts": {
    "dev": "next dev",
    "content:validate": "tsx scripts/validate-content.ts",
    "email:test": "tsx scripts/send-test-email.ts",
    "db:migrate": "node db/migrate.mjs",
    "content:pull": "tsx scripts/sync-mongodb.ts",
    "build": "npm run content:validate && next build",
    "build:release": "SITE_RELEASE=true npm run build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "start": "next start",
    "preview": "next start -p 4173",
    "test:e2e": "playwright test",
    "content:approve": "tsx scripts/apply-editorial-approval.ts",
    "build:preview": "SITE_RELEASE=false npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.22.0"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "mongodb": "7.7.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.14",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "compression": "1.8.2"
  }
}
