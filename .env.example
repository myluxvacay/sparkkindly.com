# Build/editor tools only. Never prefix these variables with NEXT_PUBLIC_.
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=sparkkindly_local
MONGODB_COLLECTION=sparkkindly
# Set to mongodb to build from a validated snapshot after npm run content:pull.
CONTENT_SOURCE=local

# For authenticated databases, set the username and auth database.
# The content:pull CLI prompts for the password without saving or echoing it.
# MONGODB_USERNAME=sparkkindly_editor
# MONGODB_AUTH_SOURCE=sparkkindly
# For the VPS via your SSH tunnel, use URI port 27018 and MONGODB_DB=sparkkindly.

# Approved public release is now the default. Explicitly opt out for a private preview.
SITE_RELEASE=true

# Runtime configuration for the server (set in /opt/sparkkindly/shared/*.env on the VM).
# /api/health reports any of DATABASE_URL, MAILERSEND_API_TOKEN, MAIL_FROM, SITE_RELEASE that is missing.
DATABASE_URL=
MAILERSEND_API_TOKEN=
MAIL_FROM=hello@sparkkindly.com

# Admin (Project 1C): allowed /admin addresses (comma-separated), digest hour (UTC), base URL for sign-in links.
ADMIN_EMAILS=
DIGEST_HOUR_UTC=7
ADMIN_LINK_BASE=
# Key that encrypts the admin authenticator secrets at rest (AES-256-GCM): base64 of 32 random bytes,
# made with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))". Without it nobody can
# sign in to /admin. Never commit it; a lost key means re-enrolling every authenticator.
ADMIN_SECRET_KEY=
