[Unit]
Description=SparkKindly web (staging)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=sparkkindly
Group=sparkkindly
WorkingDirectory=/opt/sparkkindly-staging/current
EnvironmentFile=/opt/sparkkindly/shared/staging.env
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=NODE_OPTIONS=--max-old-space-size=384
ExecStart=/opt/sparkkindly/node/bin/node server.js
Restart=always
RestartSec=2
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
