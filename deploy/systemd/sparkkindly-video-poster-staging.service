[Unit]
Description=SparkKindly video poster (staging): video selection, uploads to TikTok and YouTube, video metrics and purge
After=network.target postgresql.service
Wants=postgresql.service

# Started every 5 minutes by sparkkindly-video-poster-staging.timer (5B review M4). Oneshot: never two runs at once. It runs
# the live release's video-worker.mjs; uploads of up to 256 MB need the longer timeout and more memory than the worker.
[Service]
Type=oneshot
User=sparkkindly-staging
Group=sparkkindly-staging
WorkingDirectory=/opt/sparkkindly-staging/current
EnvironmentFile=/opt/sparkkindly/shared/staging.env
Environment=NODE_OPTIONS=--max-old-space-size=384
ExecStart=/opt/sparkkindly/node/bin/node video-worker.mjs
TimeoutStartSec=1800
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
