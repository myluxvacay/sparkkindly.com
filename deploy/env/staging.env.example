NODE_ENV=production
PORT=3101
HOSTNAME=127.0.0.1
DATABASE_URL=postgres://sparkkindly_staging:__DB_PASSWORD__@127.0.0.1:5432/sparkkindly_staging
MAIL_FROM=hello@sparkkindly.com
# Placeholder so /api/health passes before the real token arrives (plan Task 10 replaces it).
MAILERSEND_API_TOKEN=pending
# Staging is noindex and never lists pages in its sitemap.
SITE_RELEASE=false
# Member accounts (Project 3A). Off unless set to true; when on, ADMIN_LINK_BASE below must point at staging.
# ACCOUNTS_ENABLED=
# Circles (Project 4). Off unless set to true; needs ACCOUNTS_ENABLED as well.
# CIRCLES_ENABLED=

# Admin (Project 1C). Comma-separated owner addresses for /admin and the digest; empty means nobody can sign in.
ADMIN_EMAILS=
DIGEST_HOUR_UTC=7
# Sign-in links point here (production defaults to https://sparkkindly.com).
ADMIN_LINK_BASE=https://staging.sparkkindly.com
# Key that encrypts the admin authenticator secrets at rest (AES-256-GCM): base64 of 32 random bytes,
# made with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))". Without it nobody can
# sign in to /admin. Never commit it; a lost key means re-enrolling every authenticator.
ADMIN_SECRET_KEY=

# Accounts (Project 3E): HMAC key for one-click unsubscribe links, a separate secret (not ADMIN_SECRET_KEY). At least
# 32 characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))". Optional: while
# empty, no unsubscribe link is minted or accepted (not a health failure). Changing it invalidates links already sent.
UNSUBSCRIBE_SECRET=
