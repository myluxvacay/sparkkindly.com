NODE_ENV=production
PORT=3100
HOSTNAME=127.0.0.1
DATABASE_URL=postgres://sparkkindly:__DB_PASSWORD__@127.0.0.1:5432/sparkkindly
MAIL_FROM=hello@sparkkindly.com
# Optional. A mailbox the owner has confirmed they read; shown on the Contact page. Leave unset until then.
# CONTACT_EMAIL=
# Optional. A one-line postal address shown on the Contact page. Set it only here, never in the repo.
# CONTACT_ADDRESS=
# Placeholder so /api/health passes before the real token arrives (plan Task 10 replaces it).
MAILERSEND_API_TOKEN=pending
SITE_RELEASE=true
# Member accounts (Project 3A). Must stay off in production until the privacy review and consent flow exist.
# ACCOUNTS_ENABLED=
# Circles (Project 4). Off unless set to true; needs ACCOUNTS_ENABLED as well.
# CIRCLES_ENABLED=
# Comments (Project 7). Off unless set to true; needs ACCOUNTS_ENABLED as well.
# COMMENTS_ENABLED=
# Contributors (Project 8). Off unless set to true; needs ACCOUNTS_ENABLED as well.
# CONTRIBUTORS_ENABLED=
# Sponsorship (Project 6). Off unless set to true; independent of ACCOUNTS_ENABLED.
# SPONSORSHIP_ENABLED=
# Social distribution (Project 5A). Off unless set to true; each platform also has its own switch in /admin/social/.
# SOCIAL_ENABLED=

# Admin (Project 1C). Comma-separated owner addresses allowed to sign in to /admin; also the digest recipients.
# Empty means nobody can sign in. Never commit a real address.
ADMIN_EMAILS=
# Hour (UTC) after which the daily digest is sent. Default 7.
DIGEST_HOUR_UTC=7
# Key that encrypts the admin authenticator secrets at rest (AES-256-GCM): base64 of 32 random bytes,
# made with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))". Without it nobody can
# sign in to /admin. Never commit it; a lost key means re-enrolling every authenticator.
ADMIN_SECRET_KEY=

# Accounts (Project 3E): HMAC key for one-click unsubscribe links, a separate secret (not ADMIN_SECRET_KEY). At least
# 32 characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))". Optional: while
# empty, no unsubscribe link is minted or accepted (not a health failure). Changing it invalidates links already sent.
UNSUBSCRIBE_SECRET=

# Social distribution (Project 5A): Meta credentials, read by the worker at call time only. Leave empty until the owner
# has the Meta approvals; while empty nothing is posted and /admin/social/ shows "no credentials". Never commit them.
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=

# Social video (Project 5B): where uploaded videos wait (quarantine/) and approved ones are kept (approved/), outside the
# release and never served; and the file the worker keeps rotating TikTok/YouTube tokens in (mode 0600, service user).
# Each environment has its own (deploy/provision/01-base.sh creates them, owned by this environment's service user,
# mode 0700); staging and production never share them. Never commit either folder or file.
SOCIAL_MEDIA_DIR=/opt/sparkkindly/shared/media/social
SOCIAL_TOKEN_FILE=/opt/sparkkindly/shared/social-tokens/tokens.json
# Largest video upload in MB (default 128, at most 256).
# SOCIAL_MAX_VIDEO_MB=128
# TikTok (Content Posting API) and YouTube (Data API v3) app credentials and the first refresh token of each, read by
# the worker at call time only. Leave empty until the owner has the approvals; while empty nothing is posted there.
# Posts stay private: TIKTOK_PRIVACY (default SELF_ONLY) and YOUTUBE_PRIVACY (default private) are changed by the owner
# only after reviewing the first posts.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
# TIKTOK_PRIVACY=SELF_ONLY
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# YOUTUBE_PRIVACY=private
