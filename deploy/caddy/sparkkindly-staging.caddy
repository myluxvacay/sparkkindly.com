# Additive site configuration for the private staging site. Install outside any web root and import it from BOTH
# /etc/caddy/Caddyfile and MyLuxVacation's tracked deploy/Caddyfile (they must stay identical; see
# deploy/activate-public.py). Does not touch MyLuxVacation's blocks.
# Open access (owner decision, 15 Nov 2026): no basic auth — deploys can be checked immediately.
# Indexing stays blocked two ways: the X-Robots-Tag header below and the app's SITE_RELEASE=false output.
staging.sparkkindly.com {
    encode gzip zstd
    header {
        X-Robots-Tag "noindex, nofollow, noarchive"
        X-Content-Type-Options "nosniff"
        ?Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
        -Server
    }
    # Brand assets and the mock-up's images change rarely (SEO audit M5); deferred so the app's own header is replaced.
    @static path /images/* /brand/*
    header @static {
        Cache-Control "public, max-age=604800"
        defer
    }
    reverse_proxy 127.0.0.1:3101
}
